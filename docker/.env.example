# Copie para .env e preencha. O .env nunca vai para o git.
# Token do IBM Quantum (plano free serve). Pegue em quantum.ibm.com, aba Account.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_CHANNEL=ibm_quantum
# Instância CRN, quando o plano exigir (ex.: crn:v1:bluemix:public:quantum-computing:...)
IBM_QUANTUM_INSTANCE=
